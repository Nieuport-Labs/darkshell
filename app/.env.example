# Copy to app/.env.local (never committed) to build FixedFloat credentials into the app.
# Users can still enter their own key in Settings → Lightning (FixedFloat); theirs wins.
# Note: anything here can be extracted from the APK by a determined person.
VITE_FF_KEY=
VITE_FF_SECRET=
# Optional origin for shared https pay links (default: https://dashboard.nieuportlabs.cz)
VITE_PAY_ORIGIN=
# Fee-grant faucet for the first gas-credit refill (default: https://faucet.libertarianskastrana.cz; empty = off)
VITE_FAUCET_URL=https://faucet.libertarianskastrana.cz
